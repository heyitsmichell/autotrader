# Copy this file to .env and fill it in. Never commit .env or share it.

# --- LLM (Groq primary, NVIDIA NIM fallback) ----------------------------------
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Smaller same-provider fallback for per-model rate limits.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Fallback is used automatically for Groq rate limits, server errors, or outages.
# Create a key at https://build.nvidia.com/ and use the hosted NIM API key.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
MAX_AGENT_ITERATIONS=20
# Automated read-only market research scans; 0 disables automatic scans.
RESEARCH_SCAN_MINUTES=60
# Let screened equity candidates enter AI analysis; they still need signal/risk approval.
# Orders execute automatically only when TRADING_MODE=auto.
AUTO_TRADE_RESEARCH_CANDIDATES=false

# --- Broker -------------------------------------------------------------------
# mock   = simulated broker, no Webull account needed (start here)
# webull = the official Webull MCP server (webull-openapi-mcp)
BROKER_MODE=mock

# Webull OpenAPI credentials (https://developer.webull.com/apis/home).
# These go only to the Webull MCP server process, never to the LLM provider.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REGION_ID=us
# uat = Webull sandbox (practice), prod = REAL MONEY
WEBULL_ENVIRONMENT=uat
WEBULL_TOKEN_DIR=./conf
# Optional: which account to trade. By default the first stock account is used.
WEBULL_ACCOUNT_ID=
# The Webull server enforces its own limits too. If left empty, the app fills in
# WEBULL_SYMBOL_WHITELIST from WATCHLIST, WEBULL_MAX_ORDER_NOTIONAL_USD from
# MAX_ORDER_USD and WEBULL_MAX_ORDER_QUANTITY from MAX_ORDER_QTY.
WEBULL_SYMBOL_WHITELIST=
WEBULL_MAX_ORDER_NOTIONAL_USD=
WEBULL_MAX_ORDER_QUANTITY=

# --- Trading behaviour --------------------------------------------------------
# approve = every trade waits for you to click Approve. auto = trades that pass
# the risk checks are placed without asking.
TRADING_MODE=approve
# Auto mode against WEBULL_ENVIRONMENT=prod is refused unless this is true.
ALLOW_LIVE_AUTO_TRADING=false
WATCHLIST=AAPL,MSFT,NVDA,SPY,QQQ
CYCLE_MINUTES=1
# Refresh technical signals, daily bars and headline sentiment every minute while open.
SIGNAL_REFRESH_MINUTES=5
AUTO_START_SCHEDULER=false
# true = regular session only (09:30-16:00 ET). false = also run/send in premarket,
# after-hours and Webull's overnight session (NIGHT), using the matching trading_session.
MARKET_HOURS_ONLY=true
# Overnight session (NIGHT, 20:00-04:00 ET) is off by default and limited by Webull to an
# approved symbol list. Enable it only for symbols Webull accepts overnight.
OVERNIGHT_TRADING=false
OVERNIGHT_SYMBOLS=

# --- Risk limits (enforced in code on every order) ------------------------------
MAX_ORDER_USD=500
MAX_POSITION_USD=2000
MAX_ORDER_QTY=50
# 0 disables only the daily trade-count cap; money and risk limits still apply.
MAX_TRADES_PER_DAY=0
MAX_DAILY_LOSS_USD=200
# Limit price must be within this % of the last price
PRICE_BAND_PCT=1.0
# Pending proposals older than this can't be approved
PROPOSAL_TTL_MINUTES=30

# --- Running unattended (see "Running unattended" in README.md) ----------------
# Start the scheduler when the app starts and after every restart (unless you
# stopped it yourself or the kill switch is on).
# AUTO_START_SCHEDULER=true   (set above)
WATCHDOG_SECONDS=30
# Alert if the broker stays disconnected this long (the app keeps reconnecting).
BROKER_DOWN_ALERT_MINUTES=5
# Warn this many days before the Webull login expires (rerun .\auth.ps1).
TOKEN_WARN_DAYS=3
# An order with unknown status that can't be found at the broker after this
# many minutes is marked failed.
RECONCILE_GIVE_UP_MINUTES=15
# Extra market closures / early closes not in the NYSE calendar (YYYY-MM-DD,comma separated)
MARKET_CLOSED_DATES=
MARKET_EARLY_CLOSE_DATES=

# --- Automatic kill switch ----------------------------------------------------
# Any trigger turns the kill switch on (no new orders until you release it).
# 0 turns a trigger off.
KILL_MAX_DRAWDOWN_PCT=10
KILL_DAILY_LOSS_USD=300
KILL_MAX_CONSECUTIVE_ERRORS=3
# What else happens when a trigger fires:
#   pause          = stop trading only; orders at Webull stay (default)
#   cancel_entries = also cancel working BUY orders; stops and targets stay
#   flatten        = cancel every order and sell every position
KILL_ACTION=pause
# Flatten sells at the last price minus this % (a marketable limit order).
FLATTEN_SLIPPAGE_PCT=0.5

# --- SPY Benchmark (auto-trading must beat S&P 500) ------------------------------
# Enable SPY benchmark tracking and enforcement
SPY_BENCHMARK_ENABLED=true
# Minimum outperformance required vs SPY over the window (e.g., 0.5 = 0.5% better than SPY over 5 days)
SPY_BENCHMARK_MIN_OUTPERFORMANCE_PCT=0.5
# Evaluation window in trading days (5 = weekly, 20 = monthly)
SPY_BENCHMARK_WINDOW_DAYS=5
# Minimum closed trades before benchmark enforcement applies
SPY_BENCHMARK_MIN_TRADES=10
# Action if underperforming: warn (log only), pause (turn on kill switch), kill (flatten + kill switch)
SPY_BENCHMARK_ACTION=warn

# --- Sentiment / News ---------------------------------------------------------------
# How often to fetch fresh headlines (in minutes). 0 = every signal refresh (legacy).
# Set higher than SIGNAL_REFRESH_MINUTES to avoid news API rate limits while keeping
# TA/bars real-time. Cached headlines are used in between.
NEWS_REFRESH_MINUTES=15
NEWS_LOOKBACK_HOURS=72
# Also score headlines with Groq LLM (requires SENTIMENT_LLM=true)
SENTIMENT_LLM=true                     # RSS items have no Webull tag; the LLM scores them
# Sentiment source for consensus gate: webull | llm | blend
SENTIMENT_SOURCE=webull
# If Webull news fails (its UAT sandbox has no news endpoint), fetch a public RSS
# feed instead. Items carry no Webull tag, so pair this with SENTIMENT_LLM=true.
# This sends watchlist symbols to the feed provider; keep false if you prefer not to.
SENTIMENT_RSS_FALLBACK=true            # Google News RSS (now fetched alongside Webull, not only on failure)
SENTIMENT_RSS_URL=https://news.google.com/rss/search?q={symbol}&hl=en-US&gl=US&ceid=US:en

# --- Daily performance report (Phase 0) -----------------------------------------
# Read-only measurement. Once per completed session the app stores net liquidation,
# cash, the benchmark close and an estimated external cash flow. No orders.
PERFORMANCE_DAILY_ENABLED=true
PERFORMANCE_BENCHMARK_SYMBOL=SPY
# Below this many trading days the report says "not enough data yet" instead of
# showing a p-value.
PERFORMANCE_MIN_DAYS=60
# Daily bars requested from Webull for the SPY close series (60-2000).
PERFORMANCE_HISTORY_DAYS=400
# Annual risk-free rate used by Sharpe and alpha, as a decimal (0.04 = 4%).
PERFORMANCE_RISK_FREE_RATE=0.0

# --- Alerts (set any channel; none is required) --------------------------------
# ntfy: install the ntfy app, subscribe to a long random topic name, put it here.
# Anyone who knows the topic name can read your alerts, so make it unguessable.
ALERT_NTFY_TOPIC=
ALERT_NTFY_SERVER=https://ntfy.sh
# Telegram: create a bot with @BotFather, then get your chat id.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Discord or Slack incoming webhook URL.
ALERT_WEBHOOK_URL=
# Email over SMTP (port 587 uses STARTTLS, 465 uses SSL). For Gmail use an app password.
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Activity-log levels always sent (orders, fills, kill switch, login and broker
# problems are sent regardless). error | warn | info, comma separated.
ALERT_LEVELS=error
ALERT_DEDUPE_MINUTES=30
ALERT_MAX_PER_HOUR=30
# A summary 10 minutes after each close: equity, day P&L, orders, LLM cost.
ALERT_DAILY_SUMMARY=true

# --- Web server (local only) --------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- Added in this patched copy ---
# Minimum minutes between LLM analysis runs (the scheduler never runs faster than this).
LLM_MIN_CYCLE_MINUTES=10
# code = code sets BUY quantity from the risk limits; llm = use the model's quantity, clamped down.
SIZING_MODE=code
# Request-size control for Groq (HTTP 413): max chars per tool result / older results shrunk to this.
AGENT_RESULT_CHARS=6000
AGENT_OLD_RESULT_CHARS=600

# --- Universe (Phase 3) -----------------------------------------------------------
# Predefined universe: sector_etfs | sp500_top | broad_etfs | custom
# sector_etfs: broad sector ETFs (XLF, XLK, XLE, etc.) + SPY/QQQ
# broad_etfs: major equity ETFs across regions/styles
# sp500_top: top N S&P 500 by dollar volume (requires cached bars)
# custom: use UNIVERSE_CUSTOM list
UNIVERSE_NAME=sector_etfs
# Custom universe (comma-separated) when UNIVERSE_NAME=custom
UNIVERSE_CUSTOM=
# For sp500_top: take top N by average daily dollar volume
UNIVERSE_TOP_N=50
# Minimum share price for universe inclusion
UNIVERSE_MIN_PRICE=5.0
# Minimum average daily dollar volume (e.g., 20M = $20M/day)
UNIVERSE_MIN_AVG_DOLLAR_VOLUME=20000000.0
# Minimum daily bars of history required
UNIVERSE_MIN_HISTORY_DAYS=250

# --- Core-Satellite Portfolio (Phase 4) --------------------------------------------
# Master switch. OFF by default: nothing below has any effect until this is true.
# When true: (1) the rebalancer buys/sells the core to its target, only in AUTO trading mode and,
# on a live account, only with ALLOW_LIVE_AUTO_TRADING=true; (2) new satellite BUYs are capped so
# the satellite never exceeds SATELLITE_MAX_PCT of equity (shrunk/zeroed by the drawdown guard).
CORE_ENABLED=false
# Core holding symbol (usually SPY)
CORE_SYMBOL=SPY
# Target core allocation as % of equity (50-95, default 80)
CORE_TARGET_PCT=80
# Maximum satellite allocation as % of equity (default 20)
SATELLITE_MAX_PCT=20
# Rebalance when core drifts beyond this % of equity (default 2%)
CORE_REBALANCE_BAND_PCT=2.0
# Minimum trade size for core rebalancing in USD (default 100)
CORE_MIN_TRADE_USD=100
# Only rebalance during market hours (default true)
CORE_REBALANCE_MARKET_HOURS_ONLY=true
# Reduce satellite risk when drawdown exceeds this % (0 = off, default 10)
SATELLITE_DRAWDOWN_GUARD_PCT=10.0
# Action when satellite drawdown guard triggers: shrink | pause | flatten_satellite
SATELLITE_DRAWDOWN_ACTION=shrink

# --- Champion/Challenger ML (Phase 5) -----------------------------------------------
# Minimum trades in shadow evaluation before promotion decision
ML_CHALLENGER_MIN_TRADES=20
# Minimum hit rate improvement over champion to promote (0.02 = 2%)
ML_CHALLENGER_MIN_HIT_RATE_IMPROVEMENT=0.02
# Minimum avg return improvement over champion to promote (0.1 = 10bps)
ML_CHALLENGER_MIN_RETURN_IMPROVEMENT=0.1
# Maximum days in shadow before forced evaluation decision
ML_CHALLENGER_MAX_DAYS=14

# --- Fast loop (re-check armed symbols on the live price between analysis cycles) ----------
# OFF by default. When true, symbols close to passing the entry gate are watched on the live
# price feed and, if the same gate passes, a BUY goes through the normal proposal/risk path.
FAST_LOOP_ENABLED=false
FAST_LOOP_SECONDS=20
FAST_LOOP_ARM_MARGIN=0.15
FAST_LOOP_MAX_ARMED=10
FAST_LOOP_COOLDOWN_MINUTES=30

# Broker request limits. Webull answers HTTP 429 "too many requests" when it is hit too hard.
# Calls are capped to this many at once, and a 429 is retried with exponential backoff.
BROKER_MAX_CONCURRENCY=4
BROKER_RATE_LIMIT_RETRIES=4
BROKER_BACKOFF_SECONDS=2
# Deadline for one broker call. On timeout the call fails as a transport error (outcome
# unknown) and is never auto-retried.
BROKER_CALL_TIMEOUT_SECONDS=30

# --- ML-first mode ------------------------------------------------------------------
# When a promoted model exists, the model ranks and sizes entries and TA is only a floor.
# With no promoted model the rules run exactly as before, so this is safe to leave on.
ML_FIRST=true
# Lowest TA score allowed when the model is in charge (never above CONSENSUS_TA_MIN)
ML_FIRST_TA_FLOOR=0.0
# Most new BUYs per cycle, best model probability first
ML_FIRST_TOP_N=3
# Scale BUY size with model confidence (only ever shrinks the code-sized quantity)
ML_SIZE_SCALING=true
# Share of full size at p == ML_MIN_P, rising linearly to 100% at ML_SIZE_FULL_P
ML_SIZE_MIN_FACTOR=0.4
ML_SIZE_FULL_P=0.62
# A model that passes the purged walk-forward test becomes the champion straight away.
# Set false to review it first, then POST /api/ml/promote (or /api/ml/reject).
ML_AUTO_PROMOTE=true

# --- Trading costs --------------------------------------------------------------------
# Reject a BUY unless its take-profit distance is at least this many times the estimated
# round-trip cost (slippage + commission, using the BACKTEST_* cost settings). 0 = off.
COST_EDGE_MULT=3.0

# --- Options Trading (Phase B) --------------------------------------------------------
# OFF by default. When true: single-leg and multi-leg option orders are enabled.
# Works against mock broker and Webull UAT first; blocked in prod unless
# ALLOW_LIVE_AUTO_TRADING=true AND feature flags enabled.
OPTIONS_ENABLED=false
# Maximum contracts per single-leg option order
OPTIONS_MAX_CONTRACTS_PER_ORDER=10
# Maximum premium per order (multiplier=100 * price * qty)
OPTIONS_MAX_NOTIONAL_USD=5000
# Allowed strategies: SINGLE, VERTICAL, STRADDLE, STRANGLE, CALENDAR, DIAGONAL, BUTTERFLY, CONDOR, COLLAR_WITH_STOCK, IRON_BUTTERFLY, IRON_CONDOR
OPTIONS_ALLOWED_STRATEGIES=SINGLE,VERTICAL,STRADDLE,STRANGLE
# Account must have options approval (checked by broker)
OPTIONS_REQUIRE_APPROVAL=true
# Minimum days to expiration for entries
OPTIONS_MIN_DTE=7
# Maximum days to expiration for entries
OPTIONS_MAX_DTE=45
# Underlyings allowed for options trading
OPTIONS_ALLOWED_UNDERLYINGS=AAPL,MSFT,NVDA,SPY,QQQ,AMZN,GOOGL,META,TSLA
# Option consensus gate (Phase B): IV rank, delta, liquidity filters
# Maximum IV rank (0-1) for long options - avoid buying when IV is extremely high (overpriced)
OPTIONS_IV_RANK_MAX=0.85
# Minimum IV rank (0-1) for short options - avoid selling when IV is extremely low (underpriced)
OPTIONS_IV_RANK_MIN=0.10
# Minimum absolute delta for long directional options (e.g., 0.20 = 20 delta minimum)
OPTIONS_DELTA_MIN=0.20
# Maximum absolute delta for long directional options (e.g., 0.80 = 80 delta maximum)
OPTIONS_DELTA_MAX=0.80
# Minimum option volume (contracts) for liquidity
OPTIONS_MIN_VOLUME=100
# Minimum open interest (contracts) for liquidity
OPTIONS_MIN_OPEN_INTEREST=500
# Maximum bid-ask spread as % of mid price (e.g., 5.0 = 5%)
OPTIONS_MAX_BID_ASK_PCT=5.0

# --- Signal-based exits (app/exits.py) -------------------------------------------
# The broker-held bracket (stop + take profit) is the primary exit. These are secondary.
# Time stop in days, matching BACKTEST_MAX_HOLD_DAYS. 0 = off.
EXIT_MAX_HOLD_DAYS=20
# A trend exit needs this many consecutive "down" readings spanning at least this many minutes.
EXIT_CONFIRM_READINGS=3
EXIT_CONFIRM_MINUTES=10
# Exit bar for the TA score. Keep it BELOW CONSENSUS_TA_MIN so a trade is not sold and re-bought on small wobbles.
EXIT_TA_FLOOR=-0.10
# Model probability must fall this far below ML_MIN_P before an exit.
EXIT_ML_MARGIN=0.10

# --- ML training quality gate -----------------------------------------------
# Minimum mean AUC for a challenger model to be promoted to champion.
# The model must also outperform rules on hit rate and avg return.
ML_MIN_AUC=0.51

# --- Strategy Improvements (Task 2) -----------------------------------------------
# Regime-aware TA thresholds: different floors for up/range/down market trends
REGIME_AWARE_ENTRIES=false
REGIME_TA_MIN_UP=0.10
REGIME_TA_MIN_RANGE=0.20
REGIME_TA_MIN_DOWN=0.30

# Relative strength filter: only enter symbols outperforming benchmark over lookback
RELATIVE_STRENGTH_ENABLED=false
RELATIVE_STRENGTH_LOOKBACK=20
RELATIVE_STRENGTH_MIN=0.0

# Volatility scaling: size positions by ATR to target consistent risk per trade
VOL_SCALING_ENABLED=false
VOL_TARGET_ATR_PCT=1.5
VOL_MAX_FACTOR=2.0

# Market regime filter: block entries when broad market is in unfavorable regime
MARKET_REGIME_FILTER=false
MARKET_REGIME_SYMBOL=SPY
MARKET_REGIME_MIN_TREND=up
MARKET_REGIME_ADX_MIN=20.0

# Trailing stops: activate at R multiple, trail by ATR from highest close
TRAILING_STOP_ENABLED=false
TRAILING_ACTIVATION_R=1.0
TRAILING_ATR_MULT=1.5

# Exit on trend break (already in exits.py, exposed for completeness)
EXIT_ON_TREND_BREAK=true
EXIT_ML_DROP=true

# --- Universe Expansion (Task 3) -----------------------------------------------
# Predefined universe: sector_etfs | sp500_top | nasdaq100_top | broad_etfs | expanded | liquid_etfs | custom
# expanded = S&P 500 top 50 + Nasdaq-100 top 50 + all liquid ETFs (deduplicated, ~150 symbols)

# Tiered scanning for large universes (rate limiting)
UNIVERSE_TIER1_SIZE=50
UNIVERSE_TIER2_SIZE=100
UNIVERSE_TIER3_SIZE=200
UNIVERSE_SCAN_ALL_TIERS=false

# Diversification limits
MAX_SECTOR_EXPOSURE_PCT=30.0
MAX_CORRELATION=0.70
# Sector map for diversification (symbol:sector, comma-separated)
SECTOR_MAP=XLK:Technology,XLF:Financials,XLV:Healthcare,XLE:Energy,XLI:Industrials,XLP:Staples,XLY:Discretionary,XLB:Materials,XLRE:RealEstate,XLU:Utilities,XLC:Communication,SPY:Broad,QQQ:Tech,VTI:Broad,IEFA:Intl,VWO:EM

# --- Fractional Shares (Phase A) -----------------------------------------------
# Enable fractional share orders (entrust_type=AMOUNT)
FRACTIONAL_ENABLED=false
FRACTIONAL_MIN_USD=1.0
FRACTIONAL_DECIMALS=4
# Whitelist of symbols supporting fractional shares (high liquidity)
FRACTIONAL_WHITELIST=AAPL,MSFT,NVDA,SPY,QQQ,AMZN,GOOGL,META,TSLA,GOOG,BRK.B,LLY,JPM,V,UNH,XOM,MA,HD,COST,PG,WMT,ABBV,PEP,KO,AVGO,TMO,ACN,ADBE,LIN,CRM,NFLX,AMD,INTC,CSCO,DIS,TXN,NEE,PFE,QCOM,HON,VZ,BMY,UPS,LOW,RTX,UNP,AMGN,IBM,GE,CAT,SPGI,INTU,SBUX,GILD,BKNG,ADP,MDLZ,ADI,VRTX,ISRG

# --- Backtest Settings -----------------------------------------------------------
BACKTEST_DATA_DIR=/tmp/bars
BACKTEST_RESULTS_DIR=/tmp/backtests
BACKTEST_UNIVERSE=
BACKTEST_MIN_BARS=60
BACKTEST_INITIAL_CASH=25000
BACKTEST_BENCHMARK_SYMBOL=SPY
BACKTEST_COMMISSION_PER_ORDER=1.0
BACKTEST_SLIPPAGE_BPS=5.0
BACKTEST_ATR_SLIPPAGE_MULT=0.03
BACKTEST_IMPACT_BPS=5.0
BACKTEST_MAX_IMPACT_BPS=100.0
BACKTEST_MAX_GROSS_EXPOSURE_PCT=100.0
BACKTEST_MAX_HOLD_DAYS=20
BACKTEST_EXIT_ON_TREND_BREAK=true
BACKTEST_ML_ENABLED=true
BACKTEST_FETCH_COUNT=1000
BACKTEST_FETCH_DELAY_SECONDS=1.0


# --- Wider universe: tech + semiconductors (added in this review) ----------------
# Names of predefined universes appended to WATCHLIST (manual WATCHLIST symbols stay first).
# Options: tech_semis (77), semiconductors (37), nasdaq100_top, sp500_top, liquid_etfs.
WATCHLIST_UNIVERSES=tech_semis
# Cap on how many universe symbols are appended (0 = all). Start around 40-60 and raise it
# once the rate limits below look healthy.
WATCHLIST_MAX=60
# Symbols you never want traded, even if a universe contains them.
WATCHLIST_EXCLUDE=
# Wider list => refresh less often and download fewer things at once.
SIGNAL_BARS_CONCURRENCY=6
# High-priced chip names (AVGO, ASML, LRCX, KLAC, MPWR) exceed MAX_ORDER_USD for one share.
# Either turn fractional on (and keep the symbol in FRACTIONAL_WHITELIST) or raise MAX_ORDER_USD.
# FRACTIONAL_ENABLED=true
# FRACTIONAL_WHITELIST=<existing list>,TSM,ASML,AMAT,LRCX,KLAC,MU,MRVL,NXPI,MCHP,ON,MPWR,ARM,SMCI,PANW,CRWD,NOW,ORCL,ANET,PLTR,SNPS,CDNS,SMH,SOXX

# --- News: Webull + Google News + Yahoo Finance, all at once --------------------
SENTIMENT_YAHOO_RSS=true               # Yahoo Finance RSS
SENTIMENT_RSS_QUERY_SUFFIX= stock      # makes bare tickers (ARM, ON, MU, NOW) unambiguous in Google News
NEWS_CONCURRENCY=4
NEWS_MAX_PER_SOURCE=10

# --- Aggressive profit-taking (live) --------------------------------------------
PROFIT_SCALE_OUT=true
PROFIT_SCALE_OUT_R=1.0                 # sell part at +1R (1R = SL_ATR_MULT * ATR, clamped)
PROFIT_SCALE_OUT_FRACTION=0.5
PROFIT_SCALE_OUT_SECOND_R=2.0          # then part of the remainder at +2R (0 = off)
PROFIT_SCALE_OUT_SECOND_FRACTION=0.5
PROFIT_BREAKEVEN_R=0.75                # once +0.75R was reached, exit if price falls back to entry
PROFIT_GIVEBACK_PCT=35                 # exit if 35% of the peak gain is given back...
PROFIT_GIVEBACK_MIN_GAIN_PCT=2.0       # ...once the peak gain was at least 2%
PROFIT_RSI_EXHAUSTION=78               # sell into strength when RSI14 >= 78 and in profit (0 = off)
TP_ATR_MULT=2.5                        # was 3.0: closer broker take-profit (1.25R with SL_ATR_MULT=2.0); scale-outs act sooner

# --- TA scoring model ---
# v1 = original six rules (default). v2 = grouped, ATR-normalised score that also uses ADX and
# volume (see app/ta.py). The score scale differs, so compare with scripts/ta_evaluate.py and
# re-check CONSENSUS_TA_MIN before switching. Retrain the ML model after switching (the TA
# score is one of its inputs).
TA_MODEL=v1

# --- Settings added by the QA fix programme (generated by scripts/gen_env_example.py) ---

# Options
# exit when premium is this far below entry
OPTIONS_EXIT_STOP_PCT=0.5
OPTIONS_EXIT_TAKE_PROFIT_PCT=0.5
# force exit when DTE <= N
OPTIONS_EXIT_DTE=2
OPTIONS_EXPIRY_CLOSE_TIME=15:45
OPTIONS_QUOTE_MAX_AGE_SECONDS=5.0
# days needed for a true IV rank
OPTIONS_IV_RANK_MIN_HISTORY=60

# Risk
MAX_ORDER_NOTIONAL=500.0
MAX_SL_PCT=8.0
MAX_RISK_PER_TRADE_USD=100.0
RISK_LOOP_SECONDS=1.0
MAX_ADDS_PER_SYMBOL=1

# Entry quality
ENTRY_PULLBACK_GATE=false
ENTRY_PULLBACK_MIN_PCT=0.02
ENTRY_PULLBACK_MAX_PCT=0.05
BLOCK_ADD_TO_LOSER=true

# Quotes
EQUITY_QUOTE_MAX_AGE_SECONDS=15.0

# Eligibility
ELIGIBILITY_ENABLED=true
ELIGIBILITY_MIN_PRICE=5.0
ELIGIBILITY_MIN_VOLUME=20000000.0
ELIGIBILITY_MIN_BARS=250
ELIGIBILITY_MAX_GAP_PCT=3.0
ELIGIBILITY_SIGNAL_FRESHNESS_MIN=60
ELIGIBILITY_EARNINGS_BLACKOUT_DAYS=3
ELIGIBILITY_FIRST_15_MIN=true
ELIGIBILITY_ONE_STARTER_PER_SYMBOL=true
ELIGIBILITY_EARNINGS_FAIL_CLOSED=true

# Storage
DB_RETENTION_DAYS=90

# Broker
# "mcp" | "sdk" (mock mode ignores it)
BROKER_EXECUTION=mcp

# Market feed
# ticks kept per symbol
FEED_RING_SIZE=2000
FEED_MAX_SUBSCRIPTIONS=100
FEED_OPTIONS_TOP_K=4

# LLM
LLM_TIMEOUT_SECONDS=25.0
LLM_DEADLINE_SECONDS=90.0

# yfinance
YFINANCE_TIMEOUT_SECONDS=8.0
YFINANCE_NEGATIVE_TTL_SECONDS=120.0
YFINANCE_BREAKER_FAILURES=5
YFINANCE_BREAKER_COOLDOWN_SECONDS=300.0

# News
HEADLINE_MAX_CHARS=300

# API
API_TOKEN_FILE=
STREAM_HEARTBEAT_SECONDS=15.0

# ML
ML_ENABLED=true
ML_MIN_P=0.52
ML_HISTORY_BARS=1000
ML_MIN_BARS=500
ML_RETRAIN_DAYS=7

# Other
REALTIME_SOURCE=auto
POLL_SECONDS=1.0
REVIEW_EVERY_DAYS=7
MIN_OUTCOMES_FOR_REVIEW=10
CONSENSUS_TA_MIN=0.15
CONSENSUS_SENT_MIN=-0.25
CONSENSUS_MIN_NEWS=3
SL_ATR_MULT=2.0
MIN_SL_PCT=1.0
BRACKET_ORDERS=true
SNAPSHOT_SECONDS=60
UNIVERSE_MAX_PER_SECTOR=5
UNIVERSE_MAX_CORRELATION=0.7
UNIVERSE_SECTOR_MAP=
# ; empty = built-in
SENTIMENT_YAHOO_RSS_URL=

# --- Settings added by the QA fix programme (generated by scripts/gen_env_example.py) ---

# Other
# app-side stop watch in premarket/after-hours (ext-hours-protection)
EXTENDED_HOURS_SOFT_STOP=true

# --- Settings added by the QA fix programme (generated by scripts/gen_env_example.py) ---

# News
# recency half-life of a headline's weight
NEWS_HALF_LIFE_HOURS=24.0
# keep only headlines naming the ticker/company
NEWS_RELEVANCE_FILTER=true
# parallel Google News requests
NEWS_GOOGLE_CONCURRENCY=1
# minimum gap between Google/Yahoo RSS requests
NEWS_RSS_SPACING_SECONDS=0.7
# pause Google News after a 429
NEWS_GOOGLE_COOLDOWN_MINUTES=20.0
# headlines per LLM scoring call (keeps JSON untruncated)
NEWS_LLM_BATCH_SIZE=10
# LLM scoring calls per refresh
NEWS_LLM_MAX_BATCHES=6
# pause LLM scoring after a provider failure
NEWS_LLM_COOLDOWN_MINUTES=10.0

# Other
# block BUYs after a negative hard-event headline
EVENT_VETO_ENABLED=true
# how long a negative event blocks entries
EVENT_VETO_HOURS=48.0
# per-symbol earnings-date cache
EARNINGS_CACHE_HOURS=12.0

# --- Settings added by the QA fix programme (generated by scripts/gen_env_example.py) ---

# Entry quality
# limit | marketable (limit at ask + offset, capped at the price band)
ENTRY_ORDER_TYPE=limit
# 0 = off; re-send an unfilled entry once as marketable (CORE only)
ENTRY_CHASE_SECONDS=0.0

# Other
# limit | market (market only in the CORE session)
EXIT_ORDER_TYPE=limit
# marketable BUY limit = ask (or last) x (1 + bps/10000)
MARKETABLE_OFFSET_BPS=10.0
# guard notional for a MARKET order = last x qty x (1 + this %)
MARKET_NOTIONAL_BUFFER_PCT=1.0

# --- Settings added by the QA fix programme (generated by scripts/gen_env_example.py) ---

# Risk
# risk budget as % of equity (0 = use MAX_RISK_PER_TRADE_USD); needs the caller to pass equity
RISK_PER_TRADE_PCT=0.0

# Backtest
# backtester models the live profit rules (scale-outs, break-even, give-back, trailing, RSI exhaustion, no-TP bracket)
BACKTEST_LIVE_EXITS=false

# Other
# false = no broker take-profit leg; entry goes out alone and the stop is placed on fill (exits are code-managed: scale-outs, trailing, give-back)
BRACKET_TAKE_PROFIT=true
# size a BUY from the risk budget (budget / (entry - stop)); MAX_ORDER_USD no longer shrinks it (MAX_POSITION_USD, MAX_ORDER_QTY and buying power still cap it)
SIZE_FROM_RISK=false

# --- Settings added by the QA fix programme (generated by scripts/gen_env_example.py) ---

# News
# fetch Webull news (get_stock_news/search_news). false = Google/Yahoo only (Webull UAT returns 404 for news)
NEWS_WEBULL_ENABLED=true

# --- Settings added by the QA fix programme (generated by scripts/gen_env_example.py) ---

# Risk
# reject a BUY outside CORE when (ask-bid)/mid exceeds this % (0 = off)
MAX_SPREAD_PCT_EXTENDED=1.0

# Entry quality

# Other
# BUY quantity multiplier in the NIGHT session (1 = off)
OVERNIGHT_SIZE_FACTOR=0.5

# --- Settings added by the QA fix programme (generated by scripts/gen_env_example.py) ---

# Options
# buy a call when the stock gate passes
OPTIONS_AUTO_ENTRY=false
OPTIONS_ENTRY_TARGET_DELTA=0.7
OPTIONS_ENTRY_TARGET_DTE=30
# per trade
OPTIONS_ENTRY_MAX_PREMIUM_USD=500.0
OPTIONS_ENTRY_MAX_OPEN=0
OPTIONS_ENTRY_MAX_PER_DAY=0
# skip when earnings this close
OPTIONS_ENTRY_EARNINGS_DAYS=7
OPTIONS_ENTRY_SKIP_OPEN_CLOSE_MINUTES=15
# exit on the stock's stop
OPTIONS_EXIT_UNDERLYING_STOP=true

# --- Settings added by the QA fix programme (generated by scripts/gen_env_example.py) ---

# Options
# sample real option spreads
OPTIONS_SPREAD_LOG=false
OPTIONS_SPREAD_LOG_TIMES=09:31,09:33,09:35,09:40,09:45,10:00,10:30,12:00,15:30,15:40,15:45,15:55

# --- Settings added by the QA fix programme (generated by scripts/gen_env_example.py) ---

# Other
TRUSTED_HOSTS=

# --- Settings added by the QA fix programme (generated by scripts/gen_env_example.py) ---

# Options
OPTIONS_ML_ENABLED=false
# share of entries that try a random delta/DTE arm
OPTIONS_ML_EXPLORE_PCT=0.2
# skip when P(win) is below this (0 = never blocks)
OPTIONS_ML_MIN_P=0.0
OPTIONS_ML_RETRAIN_DAYS=7
# weight of a live outcome vs a modelled one
OPTIONS_ML_LIVE_WEIGHT=5.0

# --- Settings added by the QA fix programme (generated by scripts/gen_env_example.py) ---

# Other
# run the momentum / put-write / VAA sleeves
SLEEVES_ENABLED=false
# virtual cash each non-swing sleeve starts with
SLEEVE_START_CAPITAL=500000.0
# a sleeve stops opening at this drawdown from its peak
SLEEVE_PAUSE_DD_PCT=-25.0
SLEEVE_MOMENTUM_ENABLED=true
SLEEVE_PUTWRITE_ENABLED=true
SLEEVE_VAA_ENABLED=true
# stocks held by the momentum sleeve
SLEEVE_MOMENTUM_N=10
SLEEVE_PUTWRITE_UNDERLYING=QQQ
# target |delta| of the sold put
SLEEVE_PUTWRITE_DELTA=0.3
# target days to expiry
SLEEVE_PUTWRITE_DTE=30
# smaller rebalance trades are skipped
SLEEVE_MIN_TRADE_USD=1000.0
# rebalances wait until this ET time
SLEEVE_REBALANCE_AFTER_ET=10:00

# --- Settings added by the QA fix programme (generated by scripts/gen_env_example.py) ---

# Other
# run virtual-money shadow strategies (no orders)
SHADOWS_ENABLED=false
# virtual cash each shadow starts with
SHADOW_START_CAPITAL=500000.0

# --- Settings added by the QA fix programme (generated by scripts/gen_env_example.py) ---

# News
# minimum gap between Google News requests
NEWS_GOOGLE_SPACING_SECONDS=2.5
# minimum time between Google News passes
NEWS_GOOGLE_REFRESH_MINUTES=30
# alert when no source returned a headline for this long
NEWS_OUTAGE_MINUTES=60
# fetch the Nasdaq per-symbol RSS feed
NEWS_NASDAQ_ENABLED=true
# Nasdaq RSS template
NEWS_NASDAQ_RSS_URL=https://www.nasdaq.com/feed/rssoutbound?symbol={symbol}
# fetch the Seeking Alpha per-symbol RSS feed
NEWS_SEEKINGALPHA_ENABLED=true
# Seeking Alpha RSS template
NEWS_SEEKINGALPHA_RSS_URL=https://seekingalpha.com/api/sa/combined/{symbol}.xml
# fetch Bing News RSS search
NEWS_BING_ENABLED=true
# Bing News RSS template
NEWS_BING_RSS_URL=https://www.bing.com/news/search?q={query}&format=rss

# --- Settings added by the QA fix programme (generated by scripts/gen_env_example.py) ---

# Other
# comma YYYY-MM-DD dates whose evening has no overnight session
OVERNIGHT_CLOSED_DATES=
