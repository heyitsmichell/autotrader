PC_BOT_DISABLED

# --- Python ---
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Frontend (web/) ---
web/node_modules/
web/.next/
web/out/
web/out_prev*/
web/tsconfig.tsbuildinfo
web/.env*.local

